NODE_ENV=development
APP_ENV=local

FRONTEND_URL=http://127.0.0.1:3000
BACKEND_URL=http://127.0.0.1:4000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
FRONTEND_PORT=3000
BACKEND_PORT=4000
DEFAULT_TENANT_TIMEZONE=Asia/Kolkata

# One shared PostgreSQL Docker container is reused by every local project.
CENTRAL_POSTGRES_CONTAINER=shared-postgres
CENTRAL_POSTGRES_VOLUME=shared-postgres-data
CENTRAL_POSTGRES_PORT=5432
CENTRAL_POSTGRES_ADMIN_USER=postgres
CENTRAL_POSTGRES_ADMIN_PASSWORD=local-postgres-only

# This project's role, databases, and schemas inside the shared container.
POSTGRES_APP_USER=logistics_app
POSTGRES_APP_PASSWORD=local-logistics-only
POSTGRES_DB=logistics
POSTGRES_TEST_DB=logistics_test
DATABASE_URL=postgresql://logistics_app:local-logistics-only@127.0.0.1:5432/logistics?schema=app
TEST_DATABASE_URL=postgresql://logistics_app:local-logistics-only@127.0.0.1:5432/logistics_test?schema=app

# Replace during FND-02 with a strong local value generated outside Git.
AUTH_SECRET=replace-in-local-env

E2E_BASE_URL=http://127.0.0.1:3000
E2E_API_URL=http://127.0.0.1:4000
E2E_TENANT_A=tenant-e2e-a
E2E_TENANT_B=tenant-e2e-b
