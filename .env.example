NODE_ENV=development
APP_ENV=local
APP_URL=http://127.0.0.1:3000
PORT=3000
DEFAULT_TENANT_TIMEZONE=Asia/Kolkata

POSTGRES_DB=logistics
POSTGRES_USER=logistics
POSTGRES_PASSWORD=local-logistics-only
DATABASE_URL=postgresql://logistics:local-logistics-only@127.0.0.1:5432/logistics?schema=public
TEST_DATABASE_URL=postgresql://logistics:local-logistics-only@127.0.0.1:5432/logistics_test?schema=public

REDIS_URL=redis://127.0.0.1:6379/0

S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=logistics-local
S3_ACCESS_KEY=local-minio
S3_SECRET_KEY=local-minio-secret
S3_FORCE_PATH_STYLE=true

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=no-reply@logistics.local

# Replace during FND-02 with a strong local value generated outside Git.
AUTH_SECRET=replace-in-local-env

E2E_BASE_URL=http://127.0.0.1:3000
E2E_TENANT_A=tenant-e2e-a
E2E_TENANT_B=tenant-e2e-b

