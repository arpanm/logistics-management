NODE_ENV=development
APP_ENV=local

FRONTEND_URL=http://127.0.0.1:3000
BACKEND_URL=http://127.0.0.1:4000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
FRONTEND_PORT=3000
BACKEND_PORT=4000
DEFAULT_TENANT_TIMEZONE=Asia/Kolkata

# One shared PostgreSQL Docker container is reused by every local project.
CENTRAL_POSTGRES_CONTAINER=shared-postgres
CENTRAL_POSTGRES_VOLUME=shared-postgres-data
CENTRAL_POSTGRES_PORT=5432
CENTRAL_POSTGRES_ADMIN_USER=postgres
CENTRAL_POSTGRES_ADMIN_PASSWORD=local-postgres-only

# This project's role, databases, and schemas inside the shared container.
POSTGRES_APP_USER=logistics_app
POSTGRES_APP_PASSWORD=local-logistics-only
POSTGRES_POSTAL_IMPORT_USER=logistics_postal_importer
POSTGRES_POSTAL_IMPORT_PASSWORD=local-postal-import-only
POSTGRES_POSTAL_OWNER=logistics_postal_owner
POSTGRES_DB=logistics
POSTGRES_TEST_DB=logistics_test
DATABASE_URL=postgresql://logistics_app:local-logistics-only@127.0.0.1:5432/logistics?schema=app
TEST_DATABASE_URL=postgresql://logistics_app:local-logistics-only@127.0.0.1:5432/logistics_test?schema=app
POSTAL_IMPORT_DATABASE_URL=postgresql://logistics_postal_importer:local-postal-import-only@127.0.0.1:5432/logistics?schema=app
TEST_POSTAL_IMPORT_DATABASE_URL=postgresql://logistics_postal_importer:local-postal-import-only@127.0.0.1:5432/logistics_test?schema=app
POSTAL_IMPORT_EXPECTED_DATABASE=logistics

# Local bootstrap credentials; override in .env and never reuse outside local development.
AUTH_SECRET=replace-with-at-least-16-random-characters
PLATFORM_ADMIN_EMAIL=admin@local.test
PLATFORM_ADMIN_PASSWORD=LocalAdmin!234
INVITATION_TTL_HOURS=72
SESSION_TTL_HOURS=24
# Enables privileged local/E2E failure injection. Runtime config rejects this in production.
ENABLE_TEST_HOOKS=true
# Local-only deterministic envelope key (32 bytes, base64). Replace outside local use.
MFA_ENCRYPTION_KEY=bG9naXN0aWNzLWxvY2FsLW1mYS1rZXktMzJieXRlISE=
MFA_KEY_VERSION=1
SUPPORTED_COUNTRIES=AE,GB,IN,SG,US
SUPPORTED_CURRENCIES=AED,EUR,GBP,INR,SGD,USD

E2E_BASE_URL=http://127.0.0.1:3000
E2E_API_URL=http://127.0.0.1:4000
E2E_TENANT_A=tenant-e2e-a
E2E_TENANT_B=tenant-e2e-b
