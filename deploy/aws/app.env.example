NODE_ENV=production
APP_ENV=production
FRONTEND_URL=https://logistics.example.com
BACKEND_URL=http://127.0.0.1:4000
FRONTEND_PORT=3000
BACKEND_PORT=4000
DEFAULT_TENANT_TIMEZONE=Asia/Kolkata
SSL_CERT_FILE=/etc/ssl/certs/aws-rds-global-bundle.pem

# URL-encode the passwords. Use the exact RDS endpoint and installed CA path.
DATABASE_URL='postgresql://logistics_app:REPLACE_URL_ENCODED_PASSWORD@database-1.REPLACE_REGION.rds.amazonaws.com:5432/logistics?schema=app&sslmode=require&sslcert=/etc/ssl/certs/aws-rds-global-bundle.pem&sslaccept=strict'
POSTAL_IMPORT_DATABASE_URL='postgresql://logistics_postal_importer:REPLACE_DIFFERENT_URL_ENCODED_PASSWORD@database-1.REPLACE_REGION.rds.amazonaws.com:5432/logistics?schema=app&sslmode=require&sslcert=/etc/ssl/certs/aws-rds-global-bundle.pem&sslaccept=strict'
POSTAL_IMPORT_EXPECTED_DATABASE=logistics
POSTAL_DIRECTORY_FILE='/opt/logistics-secrets/india-post-pincode-directory.csv'
POSTAL_DIRECTORY_SHA256='701ee84ba125a914e7ffc979c0308b3a041b8adffa85ec9d5f4e0579ecf062e5'
POSTAL_DIRECTORY_VERSION='ogd-2025-10-03'
POSTAL_DIRECTORY_SOURCE_NAME='India Post / OGD All India Pincode Directory'
POSTAL_DIRECTORY_SOURCE_URI='https://www.data.gov.in/resource/all-india-pincode-directory-till-last-month'
POSTAL_DIRECTORY_IMPORTED_BY='aws-deploy'
AUTH_SECRET='REPLACE_WITH_OPENSSL_RAND_HEX_32'
# The one-time production seed creates/updates this Platform Admin. Replace both
# placeholders before seeding; never use the local admin@local.test credential.
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD='REPLACE_WITH_A_UNIQUE_LONG_PASSWORD'
INVITATION_TTL_HOURS=72
SESSION_TTL_HOURS=24
ENABLE_TEST_HOOKS=false
MFA_ENCRYPTION_KEY='REPLACE_WITH_OPENSSL_RAND_BASE64_32'
MFA_KEY_VERSION=1
SUPPORTED_COUNTRIES=AE,GB,IN,SG,US
SUPPORTED_CURRENCIES=AED,EUR,GBP,INR,SGD,USD
