NODE_ENV=production
APP_ENV=production
FRONTEND_URL=https://logistics.example.com
BACKEND_URL=http://127.0.0.1:4000
FRONTEND_PORT=3000
BACKEND_PORT=4000
DEFAULT_TENANT_TIMEZONE=Asia/Kolkata

# URL-encode the username/password. Keep sslmode=require for RDS.
DATABASE_URL='postgresql://logistics_app:REPLACE_URL_ENCODED_PASSWORD@RDS_ENDPOINT:5432/logistics?schema=app&sslmode=require'
AUTH_SECRET='REPLACE_WITH_OPENSSL_RAND_HEX_32'
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD='REPLACE_WITH_A_UNIQUE_LONG_PASSWORD'
INVITATION_TTL_HOURS=72
SESSION_TTL_HOURS=24
ENABLE_TEST_HOOKS=false
MFA_ENCRYPTION_KEY='REPLACE_WITH_OPENSSL_RAND_BASE64_32'
MFA_KEY_VERSION=1
SUPPORTED_COUNTRIES=AE,GB,IN,SG,US
SUPPORTED_CURRENCIES=AED,EUR,GBP,INR,SGD,USD
