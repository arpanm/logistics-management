[Unit]
Description=Logistics Control Tower backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=logistics
Group=logistics
WorkingDirectory=/opt/logistics-management/apps/backend
EnvironmentFile=/etc/logistics-management.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node dist/main.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
