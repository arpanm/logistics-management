{
  "name": "logistics-control-tower",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "22.x || 24.x",
    "pnpm": ">=11 <12"
  },
  "description": "Multi-tenant logistics operations control tower",
  "scripts": {
    "policy:check": "bash scripts/policy-check.sh",
    "check": "bash scripts/run-workspace-checks.sh",
    "dev": "bash scripts/run-app-command.sh dev",
    "build": "bash scripts/run-app-command.sh build",
    "start:local": "bash scripts/run-app-command.sh start:local",
    "db:migrate": "bash scripts/run-app-command.sh db:migrate",
    "test:e2e": "bash scripts/e2e.sh",
    "verify": "bash scripts/verify.sh",
    "db:seed": "pnpm --filter @logistics/db run db:seed",
    "demo:seed": "bash scripts/run-app-command.sh demo:seed",
    "db:reset:test": "pnpm --filter @logistics/db run db:reset:test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.55.0",
    "eslint": "9.34.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0"
  }
}
