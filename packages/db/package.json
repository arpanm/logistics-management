{
  "name": "@logistics/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx src/seed.ts",
    "demo:seed": "tsx src/demo-seed.ts",
    "db:reset:test": "tsx src/reset-test.ts",
    "postal:import": "tsx src/import-postal-directory.ts",
    "postal:verify-ownership": "tsx src/verify-postal-ownership.ts",
    "format:check": "prettier --check src && prisma validate",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "argon2": "0.44.0"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "eslint": "9.34.0",
    "prettier": "3.6.2",
    "prisma": "6.19.3",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "prisma": {
    "seed": "tsx src/seed.ts"
  }
}
